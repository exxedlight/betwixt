{
  "video": {
    "save-path": "~/Screenshots",
    "start-command": "wf-recorder -a --audio='alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Headphones__sink.monitor' --file-format=mp4 -f {file}",
    "stop-command": "pkill -INT -x wf-recorder",
    "start-sound": "~/OWN/Betwixt/resources/sounds/video-record-start.wav",
    "stop-sound": "~/OWN/Betwixt/resources/sounds/video-record-end.wav"
  },
  "img": {
    "save-path": "~/Screenshots",
    "shutter-sound": "~/OWN/Betwixt/resources/sounds/shutter1.wav",
    "area-to-clipboard-command": "grimblast copy area",
    "area-markup-command": "grimblast --freeze save output - | satty --disable-notifications --filename -",
    "fullscreen-to-clipboard-command": "grim - | wl-copy",
    "save-to-folder-command": "grim - | tee {file} | wl-copy"
  },
  "translate": {
    "source-lang": "eng",
    "target-lang": "ru",
    "tesseract-psm": "6",
    "tesseract-oem": "1"
  }
}